---
import { club } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { label: "About", href: "#about" },
  { label: "What we offer", href: "#offer" },
  { label: "Coach", href: "#coach" },
  { label: "Get involved", href: "#join" },
];
---

<header
  class="sticky top-0 z-50 border-b border-navy-700/15 bg-cream-50/85 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-2.5">
    <a href={base + "/"} class="group flex items-center gap-2.5">
      <img
        src={base + "/logo.png"}
        alt={club.name + " logo"}
        width="44"
        height="44"
        class="h-11 w-11 transition-transform group-hover:scale-105"
      />
      <span
        class="font-display text-base leading-none tracking-tight text-navy-900 sm:text-lg"
        >{club.shortName}</span
      >
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-semibold text-navy-800 transition-colors hover:text-sage-600"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="#join"
        class="rounded-full bg-navy-700 px-4 py-2 text-sm font-bold text-cream-50 transition-transform hover:-translate-y-0.5 hover:bg-navy-800"
        >Join us →</a
      >
    </nav>

    <a
      href="#join"
      class="rounded-full bg-navy-700 px-4 py-2 text-sm font-bold text-cream-50 lg:hidden"
      >Join us →</a
    >
  </div>
</header>
