---
import Base from "../layouts/Base.astro";
import { club, status, gains, offerings, coach, copy } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const formAction = "https://api.web3forms.com/submit";
const coachInitial = coach.name.charAt(0);
---

<Base>
  {/* ─────────────────────────────  HERO  ───────────────────────────── */}
  <section class="relative overflow-hidden bg-navy-900 text-cream-50">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      aria-hidden="true"
    >
      <div
        class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-sage-400"
      >
      </div>
      <div class="court-line absolute top-1/3 h-px w-full text-sage-400"></div>
      <div class="court-line absolute top-2/3 h-px w-full text-sage-400"></div>
    </div>

    <div
      class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 sm:py-28 lg:grid-cols-[1.15fr_0.85fr]"
    >
      <div class="animate-rise">
        <p
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-sage-400/30 bg-navy-800/60 px-4 py-1.5 text-sm font-semibold text-sage-300"
        >
          <span class="h-2 w-2 rounded-full bg-spark"></span>
          {club.location}
        </p>

        <h1 class="font-display uppercase text-cream-50">
          <span
            class="block text-5xl sm:text-6xl lg:text-7xl"
            style="font-variation-settings: 'wght' 850, 'wdth' 110;">Northstowe</span
          >
          <span class="mt-1 block text-3xl text-sage-300 sm:text-4xl lg:text-5xl"
            >Social Volleyball Club</span
          >
        </h1>

        <p class="mt-7 max-w-md text-lg leading-relaxed text-cream-200/85">
          {club.pitch}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="#join"
            class="rounded-full bg-sage-500 px-7 py-3.5 font-bold text-navy-950 transition-transform hover:-translate-y-1 hover:bg-sage-400"
            >Join the community →</a
          >
          <a
            href="#about"
            class="rounded-full border border-cream-200/30 px-7 py-3.5 font-bold text-cream-50 transition-colors hover:border-sage-300 hover:text-sage-300"
            >Our story</a
          >
        </div>
      </div>

      <div class="relative hidden justify-self-center lg:block">
        <div
          class="absolute -inset-8 rounded-full bg-sage-400/10 blur-3xl"
          aria-hidden="true"
        >
        </div>
        {/* Volleyball graphic */}
        <img
          src={base + "/volleyball.svg"}
          alt="Volleyball"
          width="288"
          height="288"
          class="animate-float-ball relative w-72 drop-shadow-2xl"
        />
      </div>
    </div>

    <div
      class="h-12 bg-cream-50"
      style="clip-path: polygon(0 100%, 100% 0, 100% 100%);"
      aria-hidden="true"
    >
    </div>
  </section>

  {/* ─────────────────────────  PURPOSE + GAINS  ───────────────────────── */}
  <section class="bg-cream-50 py-20 sm:py-28">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1fr_0.8fr]">
      <div>
        <p class="font-semibold uppercase tracking-[0.2em] text-sage-600">
          Our purpose
        </p>
        <h2 class="font-display mt-3 text-4xl text-navy-900 sm:text-5xl">
          There's always a spot for you.
        </h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-navy-800/80">
          {copy.purpose}
        </p>
      </div>

      <div class="rounded-3xl bg-navy-900 p-8 text-cream-50">
        <h3 class="font-display text-2xl text-sage-300">What you'll gain</h3>
        <ul class="mt-5 space-y-3">
          {
            gains.map((g) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-sage-500 text-navy-950"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 20 20" class="h-3 w-3" fill="currentColor">
                    <path d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.3 3.3 6.8-6.8a1 1 0 011.4 0z" />
                  </svg>
                </span>
                <span class="text-cream-100/90">{g}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  ABOUT / STORY  ───────────────────────────── */}
  <section id="about" class="scroll-mt-20 bg-sage-500 py-20 text-navy-950 sm:py-28">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <p class="font-semibold uppercase tracking-[0.2em] text-navy-800/70">
        Our story
      </p>
      <h2 class="font-display mt-3 text-4xl text-navy-950 sm:text-5xl">
        It started with a simple idea.
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-navy-900/85">
        {copy.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  OUR GOAL  ───────────────────────────── */}
  <section class="bg-cream-50 py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-5">
      <div class="rounded-3xl border border-navy-700/15 bg-white/50 p-8 sm:p-12">
        <p class="font-semibold uppercase tracking-[0.2em] text-sage-600">
          Our goal
        </p>
        <h2 class="font-display mt-3 text-3xl text-navy-900 sm:text-4xl">
          From social sessions to a real club.
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-navy-800/80">
          {copy.goal}
        </p>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  WHAT WE OFFER  ───────────────────────────── */}
  <section id="offer" class="scroll-mt-20 bg-cream-50 pb-20 sm:pb-28">
    <div class="mx-auto max-w-6xl px-5">
      <div class="max-w-2xl">
        <p class="font-semibold uppercase tracking-[0.2em] text-sage-600">
          What we offer
        </p>
        <h2 class="font-display mt-3 text-4xl text-navy-900 sm:text-5xl">
          However you want to play.
        </h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          offerings.map((o, i) => (
            <article class="group relative overflow-hidden rounded-3xl bg-navy-900 p-8 text-cream-50">
              <span
                class="font-display absolute -right-3 -top-5 text-8xl text-sage-400/10 transition-colors group-hover:text-sage-400/20"
                aria-hidden="true"
              >
                0{i + 1}
              </span>
              <h3 class="relative font-display text-2xl text-sage-300">
                {o.title}
              </h3>
              <p class="relative mt-3 text-cream-200/85">{o.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  MEET THE COACH  ───────────────────────────── */}
  <section id="coach" class="scroll-mt-20 bg-navy-900 py-20 text-cream-50 sm:py-28">
    <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 sm:grid-cols-[auto_1fr]">
      <div class="justify-self-center sm:justify-self-start">
        {
          coach.photo ? (
            <img
              src={import.meta.env.BASE_URL.replace(/\/$/, "") + "/" + coach.photo}
              alt={`${coach.name}, club coach`}
              class="h-44 w-44 rounded-3xl object-cover"
              width="176"
              height="176"
            />
          ) : (
            <div
              class="grid h-44 w-44 place-items-center rounded-3xl bg-sage-500 font-display text-7xl text-navy-950"
              aria-hidden="true"
            >
              {coachInitial}
            </div>
          )
        }
      </div>

      <div>
        <p class="font-semibold uppercase tracking-[0.2em] text-sage-300">
          Meet the coach
        </p>
        <h2 class="font-display mt-3 text-4xl text-cream-50 sm:text-5xl">
          {coach.name}
        </h2>
        <div class="mt-5 space-y-4 text-cream-200/85">
          {coach.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  {/* ─────────────────────────────  GET INVOLVED  ───────────────────────────── */}
  <section id="join" class="scroll-mt-20 bg-cream-50 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-5">
      {/* Honest pre-launch status banner */}
      {
        status.organising && (
          <div class="mb-12 rounded-3xl bg-sage-500 p-8 text-center text-navy-950 sm:p-10">
            <h2 class="font-display text-3xl sm:text-4xl">{status.headline}</h2>
            <p class="mx-auto mt-3 max-w-2xl text-lg text-navy-900/85">
              {status.body}
            </p>
            {club.registerFormUrl && (
              <a
                href={club.registerFormUrl}
                target="_blank"
                rel="noopener"
                class="mt-6 inline-block rounded-full bg-navy-700 px-7 py-3.5 font-bold text-cream-50 transition-transform hover:-translate-y-0.5 hover:bg-navy-800"
              >
                Register your interest →
              </a>
            )}
            {!club.registerFormUrl && (
              <p class="mt-5 text-sm text-navy-900/60">
                {/* TODO: add the Google Form URL in src/config.ts to show a button here. */}
                Or send us a message below.
              </p>
            )}
          </div>
        )
      }

      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="font-semibold uppercase tracking-[0.2em] text-sage-600">
            Get in touch
          </p>
          <h2 class="font-display mt-3 text-4xl text-navy-900 sm:text-5xl">
            Be part of the journey.
          </h2>
          <p class="mt-5 max-w-sm text-lg text-navy-800/80">
            Complete beginner or seasoned player — drop us a message and we'll
            tell you everything you need to get started.
          </p>

          <div class="court-line mt-8 h-px w-32 text-navy-600/40"></div>

          <a
            href={`mailto:${club.email}`}
            class="mt-8 inline-block text-navy-800 underline-offset-4 hover:text-sage-600 hover:underline"
            >{club.email}</a
          >
        </div>

        {/* Web3Forms — static-friendly, free. Submits via JS (the inline script
            at the end of this file), with a no-JS fallback to a standard POST. */}
        <form
          id="contact-form"
          action={formAction}
          method="POST"
          class="rounded-3xl border border-navy-700/15 bg-white/60 p-6 shadow-sm sm:p-8"
        >
          <input type="hidden" name="access_key" value={club.web3formsKey} />
          <input
            type="hidden"
            name="subject"
            value="New message from the Northstowe Social Volleyball website"
          />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display:none"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-semibold text-navy-900">First name</span>
              <input
                type="text"
                name="first_name"
                required
                autocomplete="given-name"
                class="mt-1.5 w-full rounded-xl border border-navy-700/20 bg-cream-50 px-4 py-3 text-navy-900 outline-none transition focus:border-navy-600 focus:ring-2 focus:ring-sage-500/40"
              />
            </label>
            <label class="block">
              <span class="text-sm font-semibold text-navy-900">Last name</span>
              <input
                type="text"
                name="last_name"
                autocomplete="family-name"
                class="mt-1.5 w-full rounded-xl border border-navy-700/20 bg-cream-50 px-4 py-3 text-navy-900 outline-none transition focus:border-navy-600 focus:ring-2 focus:ring-sage-500/40"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="text-sm font-semibold text-navy-900">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1.5 w-full rounded-xl border border-navy-700/20 bg-cream-50 px-4 py-3 text-navy-900 outline-none transition focus:border-navy-600 focus:ring-2 focus:ring-sage-500/40"
            />
          </label>

          <label class="mt-5 block">
            <span class="text-sm font-semibold text-navy-900">Message</span>
            <textarea
              name="message"
              rows="4"
              required
              placeholder="Hi! I'd love to come and try volleyball…"
              class="mt-1.5 w-full rounded-xl border border-navy-700/20 bg-cream-50 px-4 py-3 text-navy-900 outline-none transition focus:border-navy-600 focus:ring-2 focus:ring-sage-500/40"
            ></textarea>
          </label>

          <button
            type="submit"
            class="mt-6 w-full rounded-full bg-navy-700 px-6 py-3.5 font-bold text-cream-50 transition-transform hover:-translate-y-0.5 hover:bg-navy-800 disabled:cursor-not-allowed disabled:opacity-70"
          >
            Send message →
          </button>

          {/* Submission status — updated by the script; polite for screen readers */}
          <p
            id="form-status"
            class="mt-3 text-center text-sm"
            role="status"
            aria-live="polite"
          >
          </p>
        </form>
      </div>
    </div>
  </section>

  <script>
    // Progressive enhancement: submit the contact form via fetch so the visitor
    // stays on the page and gets inline feedback. If JS is disabled the form
    // still works via its native action/method (standard Web3Forms redirect).
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const status = document.getElementById("form-status");

    if (form && status) {
      const button = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement;
      const originalText = button.textContent;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        status.textContent = "";
        status.className = "mt-3 text-center text-sm text-navy-700/70";
        button.textContent = "Sending…";
        button.disabled = true;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          const data = await response.json();

          if (response.ok) {
            status.textContent =
              "Thanks! Your message is on its way — we'll be in touch soon.";
            status.className = "mt-3 text-center text-sm font-semibold text-sage-700";
            form.reset();
          } else {
            status.textContent =
              data.message || "Something went wrong. Please try again.";
            status.className = "mt-3 text-center text-sm font-semibold text-spark-deep";
          }
        } catch {
          status.textContent =
            "Couldn't send right now. Please email us instead.";
          status.className = "mt-3 text-center text-sm font-semibold text-spark-deep";
        } finally {
          button.textContent = originalText;
          button.disabled = false;
        }
      });
    }
  </script>
</Base>
